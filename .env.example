PORT=8080
DB_PATH=./data/defta.db
PAGE_SIZE=30
VERSION=1.4.0
BUILD_DATE=2026-09-21
JWT_SECRET=
JWT_ISSUER=defta-librairie
JWT_AUDIENCE=defta-librairie-web
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_COOKIE_SECURE=false

# Couvertures de livre v1.4
COVERS_ENABLED=false
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false
MINIO_BUCKET_COVERS=book-covers
MINIO_SOURCE_RETENTION_HOURS=24
NATS_URL=nats://nats:4222
NATS_USER=
NATS_PASSWORD=
NATS_COVERS_STREAM=BOOK_COVERS
NATS_COVERS_SUBJECT=book.covers.process.v1
NATS_COVERS_CONSUMER=cover-worker-v1
NATS_SUBMISSION_STREAM=BOOK_SUBMISSIONS
NATS_SUBMISSION_SUBJECT=book.submissions.moderate.v1
NATS_SUBMISSION_CONSUMER=book-submission-worker-v1
NATS_IMPORT_STREAM=COVER_IMPORTS
NATS_IMPORT_SUBJECT=cover.imports.moderate.v1
NATS_IMPORT_CONSUMER=cover-import-moderation-worker-v1
NATS_OCR_SUBJECT=cover.imports.ocr.v1
NATS_OCR_CONSUMER=cover-import-ocr-worker-v1
NATS_MATCH_SUBJECT=cover.imports.match.v1
NATS_MATCH_CONSUMER=cover-import-matching-worker-v1
# OCR local Tesseract 5, sans appel externe.
OCR_ENGINE=tesseract
OCR_LANGUAGE=ara
OCR_TIMEOUT_SECONDS=20
# Identité du compte hôte propriétaire de ./data pour le worker Docker.
COVER_WORKER_UID=1000
COVER_WORKER_GID=1000
NSFW_MODERATION_ENDPOINT=http://nsfw-moderator:8090
COVER_WORKER_MAX_DELIVER=5
COVER_MAX_BYTES=10485760
COVER_MAX_PIXELS=24000000

# Service Python OCR expérimental US-1713 : variables du conteneur uniquement.
# Activation Go facultative : voir docs/OCR_GO_ADAPTER_V1_7_1.md.
OCR_SERVICE_TIMEOUT_SECONDS=30
OCR_SERVICE_MAX_IMAGE_BYTES=10485760
OCR_SERVICE_MAX_PIXELS=24000000
OCR_SERVICE_MAX_DIMENSION=10000
OCR_SERVICE_MAX_OUTPUT_BYTES=1048576
OCR_SERVICE_UPLOAD_TIMEOUT_SECONDS=15
OCR_SERVICE_CONCURRENCY=1

# US-1714 : désactivé par défaut, aucun fallback silencieux quand activé.
OCR_EXPERIMENTAL_ENABLED=false
OCR_EXPERIMENTAL_ENDPOINT=http://127.0.0.1:8091
OCR_EXPERIMENTAL_TIMEOUT_SECONDS=60
